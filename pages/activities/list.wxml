<!--pages/activities/list.wxml-->
<view class="container">
  <view class="header">
    <text class="title">🏆 车队活动</text>
    <text class="subtitle">按开始时间排列，点击查看详情</text>
  </view>

  <view class="admin-bar" wx:if="{{isAdmin}}">
    <view class="btn-primary" bindtap="goToCreate">➕ 新建活动</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{activities.length > 0}}">
    <view
      class="activity-card"
      wx:for="{{activities}}"
      wx:key="_id"
      bindtap="goToDetail"
      data-id="{{item._id}}"
    >
      <view class="card-title">
        {{item.name}}
        <text class="status-tag {{item.statusCls}}">{{item.statusText}}</text>
      </view>
      <text class="card-time">📅 {{item.startTime}} ~ {{item.endTime}}</text>
      <text class="card-desc" wx:if="{{item.description}}">{{item.description}}</text>
      <view class="card-meta">
        <text>👥 报名 {{item.participantCount}} 人</text>
        <text>💰 奖金 {{item.prizeCount}} 条</text>
      </view>
      <view class="card-actions" wx:if="{{isAdmin}}" catchtap="stopPropagation">
        <text class="action-btn action-edit" catchtap="goToEdit" data-id="{{item._id}}">✏️ 编辑</text>
        <text class="action-btn action-delete" catchtap="deleteActivity" data-id="{{item._id}}" data-name="{{item.name}}">🗑️ 删除</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty">暂无车队活动</view>
</view>
