@import './common.wxss';

/* 编辑页：全宽表单，避免单行输入过窄 */
.edit-page.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.edit-page .form-card {
  padding: 32rpx 28rpx;
}

.edit-page .section-title {
  font-size: 34rpx;
  margin-bottom: 28rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.edit-page .form-item {
  margin-bottom: 32rpx;
}

.edit-page .form-item-last {
  margin-bottom: 0;
}

.edit-page .label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 统一字段容器：撑满卡片宽度 */
.field-box {
  width: 100%;
}

.field-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-picker {
  width: 100%;
  display: block;
}

.edit-page .input,
.edit-page .textarea,
.edit-page .picker-block {
  width: 100%;
  box-sizing: border-box;
  display: block;
  background: #fafafa;
  border: 2rpx solid #e0d0ec;
  border-radius: 14rpx;
}

.edit-page .input-lg {
  min-height: 96rpx;
  padding: 28rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.4;
}

.edit-page .textarea-lg {
  width: 100%;
  min-height: 220rpx;
  padding: 28rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.picker-block {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 24rpx;
  gap: 20rpx;
}

.picker-block-single {
  min-height: 96rpx;
}

.picker-tag {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #552583;
  background: #f3eef8;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.picker-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  word-break: break-all;
}

/* 奖金列表：纵向排布，名称与金额各占一行 */
.edit-page .prize-item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
  border: 2rpx solid #eee;
  border-radius: 14rpx;
}

.prize-item-main {
  width: 100%;
  margin-bottom: 16rpx;
}

.prize-item-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.prize-item-note {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  word-break: break-all;
}

.edit-page .prize-item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eee;
}

.edit-page .prize-item-actions text {
  font-size: 28rpx;
  margin-left: 0;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
}

.edit-page .prize-edit {
  background: #f3eef8;
}

.edit-page .prize-del {
  background: #fff1f0;
}

.edit-page .add-prize-btn {
  padding: 32rpx;
  font-size: 30rpx;
  margin-top: 8rpx;
}

/* 奖金弹窗：加宽、表单项纵向铺满 */
.modal-prize {
  width: 94%;
  max-width: 700rpx;
  max-height: 85vh;
  padding: 36rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.modal-prize .modal-title {
  flex-shrink: 0;
  margin-bottom: 24rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 58vh;
  width: 100%;
}

.modal-prize .form-item {
  margin-bottom: 28rpx;
  width: 100%;
}

.modal-prize .label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}

.modal-prize .input,
.modal-prize .picker-block {
  width: 100%;
  box-sizing: border-box;
  background: #fafafa;
  border: 2rpx solid #e0d0ec;
  border-radius: 14rpx;
}

.modal-prize .input-lg {
  min-height: 96rpx;
  padding: 28rpx 24rpx;
  font-size: 32rpx;
}

.modal-prize .field-picker {
  width: 100%;
  display: block;
}

.modal-prize .picker-block-single {
  padding: 28rpx 24rpx;
}

.modal-prize .picker-text {
  font-size: 32rpx;
  color: #552583;
}

.modal-prize .modal-buttons {
  flex-shrink: 0;
  margin-top: 24rpx;
}

.modal-prize .modal-buttons .btn {
  padding: 26rpx;
  font-size: 30rpx;
}
