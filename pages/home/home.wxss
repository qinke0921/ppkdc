/* pages/home/home.wxss */
/* 湖人紫金主题：#552583 紫色  #FDB927 金色 */
.container {
  min-height: 100vh;
  background-color: #552583;
  position: relative;
}

/* 背景图片 */
.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 半透明遮罩 */
.bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(85, 37, 131, 0.7);
  z-index: 1;
}

.intro-section {
  position: relative;
  z-index: 2;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 底部金色装饰线 */
.intro-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #FDB927, transparent);
}

.team-logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.intro-header { margin-bottom: 20rpx; }

.intro-title {
  font-size: 72rpx;
  font-weight: bold;
  color: #FDB927;
  display: block;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
}

.intro-content { 
  display: flex; 
  flex-direction: column; 
  gap: 15rpx;
  margin-top: 40rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.intro-desc.highlight {
  color: #FDB927;
  font-weight: bold;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 广告语板块 */
.ad-section {
  position: relative;
  z-index: 2;
  background: linear-gradient(135deg, #fef9e7, #fde6b9);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(253, 185, 39, 0.2);
  border: 1rpx solid #FDB927;
}

.ad-badge { font-size: 36rpx; flex-shrink: 0; }

.ad-text { font-size: 28rpx; color: #552583; line-height: 1.5; font-weight: 500; }

.feature-section { 
  position: relative;
  z-index: 2;
  display: flex; 
  flex-direction: column; 
  gap: 20rpx; 
  padding: 20rpx;
}

.feature-item {
  position: relative;
  z-index: 2;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(85, 37, 131, 0.08);
  border-left: 5rpx solid #FDB927;
}

.feature-item.disabled { opacity: 0.6; }

.feature-icon { font-size: 60rpx; }

.feature-text { font-size: 32rpx; color: #333; flex: 1; }

.feature-coming {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}