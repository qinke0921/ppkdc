/* pages/weekly/weekly.wxss */
/* 湖人紫金主题：#552583 紫色  #FDB927 金色 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #552583 0%, #6b3483 25%, #552583 50%, #3d1e63 75%, #2a1550 100%);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #FDB927, transparent);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.header-left { display: flex; flex-direction: column; gap: 8rpx; }
.header-right { display: flex; align-items: center; gap: 20rpx; }

.week-range { font-size: 24rpx; color: rgba(253, 185, 39, 0.85); display: block; }

.share-btn {
  background: rgba(253, 185, 39, 0.25);
  border: 2rpx solid rgba(253, 185, 39, 0.5);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  color: #FDB927;
  line-height: 1;
}

/* 无任务 */
.no-task { text-align: center; padding: 100rpx 0; }
.no-task-text { display: block; font-size: 32rpx; color: #999; margin-bottom: 40rpx; }
.create-btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
}

/* 历史任务提示 */
.history-tip {
  background: linear-gradient(135deg, #fef9e7, #fde6b9);
  color: #b8860b;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.new-task-btn {
  background: linear-gradient(135deg, #FDB927, #f5a623);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 任务卡片 */
.task-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(85, 37, 131, 0.1);
}

.task-map { text-align: center; margin-bottom: 20rpx; }

.map-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #552583;
}

.task-times { margin-bottom: 20rpx; }

.time-row { display: flex; align-items: center; padding: 10rpx 0; }
.gender-icon { font-size: 28rpx; margin-right: 10rpx; }
.time-label { font-size: 26rpx; color: #666; }
.time-value { font-size: 28rpx; font-weight: bold; color: #333; }

.edit-target-btn-new {
  margin-top: 15rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
}

.rewards { font-size: 24rpx; color: #666; margin-bottom: 20rpx; display: flex; flex-direction: column; }

.tip {
  font-size: 24rpx;
  color: #b8860b;
  background: #fef9e7;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
  border: 1rpx solid #f5d78e;
}

.copy-task-btn {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(85, 37, 131, 0.3);
}

/* 管理员栏 */
.admin-bar { display: flex; gap: 20rpx; margin-bottom: 20rpx; }

.add-score-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: #fff;
  color: #552583;
  border: 2rpx solid #552583;
}

.lottery-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #FDB927, #f5a623);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(253, 185, 39, 0.35);
}

/* 成绩列表卡片 */
.list-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(85, 37, 131, 0.1);
}

.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.list-title { font-size: 30rpx; font-weight: bold; color: #333; }
.copy-btn { padding: 10rpx 20rpx; background-color: #f5f5f5; border-radius: 8rpx; font-size: 24rpx; color: #666; }

.player-list { display: flex; flex-direction: column; }

.player-item {
  display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0;
}

.player-item.fastest { background: #fef9e7; margin: 0 -20rpx; padding: 16rpx 20rpx; }

.player-info { display: flex; align-items: center; }
.player-name { font-size: 28rpx; color: #333; margin-right: 20rpx; }
.player-score { font-size: 28rpx; font-weight: bold; color: #552583; }

.player-actions { display: flex; }
.edit-btn, .delete-btn { font-size: 28rpx; padding: 8rpx 12rpx; margin-left: 10rpx; }
.delete-btn { color: #ff4d4f; }

.empty-hint { display: block; text-align: center; color: #999; font-size: 26rpx; padding: 20rpx; }

/* 弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex; align-items: center; justify-content: center; z-index: 1000;
}

.modal {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 0;
  margin: 20rpx;
  width: 90%;
  max-height: 85vh;
  overflow-y: auto;
  border-top: 6rpx solid #FDB927;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin: 0;
  padding: 30rpx 24rpx;
  background: #f8f9fa;
  color: #552583;
  position: relative;
}

.modal-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #FDB927, transparent);
}

.form-item { margin-bottom: 40rpx; padding: 0 30rpx; }

.label { display: block; font-size: 30rpx; color: #333; margin-bottom: 15rpx; font-weight: 600; }

.input {
  border: 2rpx solid #d4b8e8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  background: #fafafa;
}

.picker-value {
  border: 2rpx solid #d4b8e8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #552583;
  min-height: 80rpx;
  background: #fafafa;
}

.map-list { max-height: 300rpx; border: 1rpx solid #d4b8e8; border-radius: 12rpx; }
.map-item { padding: 16rpx 20rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 26rpx; }
.map-item.active { background: #f3e8ff; color: #552583; }

.radio-label { display: inline-flex; align-items: center; margin-right: 30rpx; font-size: 28rpx; }

.player-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.fail-tag {
  color: #ff3b30;
  font-size: 24rpx;
  font-weight: bold;
  background: #fff1f0;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ffccc7;
  line-height: 1.2;
}

.modal-buttons { display: flex; gap: 20rpx; margin: 30rpx; padding-top: 20rpx; border-top: 1rpx solid #eee; }

.btn { flex: 1; text-align: center; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; font-weight: bold; }
.btn.cancel { background: #f5f5f5; color: #666; }
.btn.confirm { background: linear-gradient(135deg, #552583, #3d1e63); color: #fff; box-shadow: 0 4rpx 12rpx rgba(85, 37, 131, 0.3); }

/* 抽奖弹窗 */
.lottery-result { text-align: center; padding: 40rpx 0; }
.winner-name { display: block; font-size: 56rpx; font-weight: bold; color: #FDB927; margin-bottom: 20rpx; }
.winner-gender { display: block; font-size: 32rpx; color: #666; margin-bottom: 10rpx; }
.winner-score { display: block; font-size: 28rpx; color: #999; }

.lottery-empty { text-align: center; padding: 60rpx 0; font-size: 32rpx; color: #666; }

.lottery-history { margin-top: 30rpx; padding: 20rpx; background: #f5f5f5; border-radius: 12rpx; }
.history-title { font-size: 26rpx; color: #666; display: block; margin-bottom: 10rpx; }
.history-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.history-list text { background: #fff; padding: 8rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; color: #333; }

/* 转盘弹窗 */
.lottery-modal { width: 90%; max-width: 700rpx; max-height: 90vh; overflow-y: auto; border-top: 6rpx solid #FDB927; }

.lottery-pool-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin: -12rpx 0 8rpx;
  line-height: 1.5;
  padding: 0 16rpx;
}

.name-scroll-container { height: 240rpx; overflow: hidden; background: #f5f5f5; border-radius: 12rpx; margin: 30rpx 0; display: flex; align-items: center; justify-content: center; }
.name-scroll-view { display: flex; flex-direction: column; align-items: center; }
.name-item { height: 80rpx; line-height: 80rpx; font-size: 36rpx; color: #333; text-align: center; }
.name-item.winner { color: #FDB927; font-size: 44rpx; font-weight: bold; }

/* 转盘（勿删：wheel-bg / names-layer / label 缺一都会导致盘面错乱） */
.wheel-wrapper { position: relative; width: 560rpx; height: 560rpx; margin: 24rpx auto 32rpx; }

.wheel-pointer-top {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  z-index: 20;
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-top: 40rpx solid #FDB927;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.25));
}

.wheel {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.18);
  border: 10rpx solid #FDB927;
  box-sizing: border-box;
}

.wheel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.names-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  pointer-events: none;
}

.wheel-label-spoke {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 160rpx;
  margin-left: -80rpx;
  margin-top: -22rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: 50% 50%;
}

.name-on-wheel {
  max-width: 150rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.55);
}

.wheel-hub {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(145deg, #fff 0%, #f3e8ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 15;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  border: 4rpx solid rgba(85, 37, 131, 0.3);
}

.wheel-hub-icon { font-size: 40rpx; line-height: 1; }

.winner-label { font-size: 28rpx; color: #552583; }