/* pages/disciples/member/member.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 30rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(85, 37, 131, 0.25);
}

.profile-game {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.profile-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.profile-card .line-badge {
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #552583;
  background: #FDB927;
  border-radius: 26rpx;
}

.profile-card .line-badge.empty {
  color: #ddd;
  background: rgba(255, 255, 255, 0.18);
  font-weight: normal;
}

.card {
  margin-top: 24rpx;
  padding: 8rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.row:last-child {
  border-bottom: none;
}

.k {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 26rpx;
  color: #888;
}

.v {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.v.muted {
  color: #ccc;
}

.edit-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  text-align: right;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #552583;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 10rpx;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #999;
}

.actions {
  display: flex;
  margin-top: 40rpx;
}

.actions .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
}

.btn.edit {
  background: linear-gradient(135deg, #FDB927, #f5a623);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(253, 185, 39, 0.3);
}

.btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.btn.confirm {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
}

.btn.disabled {
  opacity: 0.6;
}
