<!--pages/disciples/task/task.wxml-->
<view class="page">
  <view class="loading-box" wx:if="{{loading}}"><text>加载中...</text></view>

  <block wx:else>
    <!-- 头部 -->
    <view class="hero">
      <view class="hero-top">
        <text class="hero-map">{{task.mapName}}</text>
        <text class="hero-badge">{{settled ? '已结算' : '剩 ' + daysLeft + ' 天'}}</text>
      </view>
      <text class="hero-range">{{dateRange}}</text>
    </view>

    <!-- 地图笔记（PDF） -->
    <view class="doc-card" wx:if="{{showMapDoc && doc}}">
      <view class="doc-row" bindtap="openDoc">
        <text class="doc-icon">📄</text>
        <view class="doc-info">
          <text class="doc-title">查看兔姐笔记</text>
          <text class="doc-sub">{{doc.fileName || '地图笔记'}}{{doc.sizeText ? ' · ' + doc.sizeText : ''}}</text>
        </view>
        <text class="doc-arrow">›</text>
      </view>
      <view class="doc-edit" wx:if="{{canManage}}" catchtap="chooseDoc">更换笔记</view>
    </view>

    <view class="doc-add" wx:elif="{{showMapDoc && canManage}}" bindtap="chooseDoc">
      <text>📄 上传兔姐笔记（PDF）</text>
    </view>

    <!-- 视频讲解 -->
    <view class="video-card" wx:if="{{task.videoUrl}}">
      <view class="video-head">
        <text class="video-title">📺 视频讲解</text>
        <text class="video-platform">{{task.videoPlatform || '网盘'}}</text>
      </view>
      <text class="video-note" wx:if="{{task.videoNote}}">{{task.videoNote}}</text>

      <view class="video-row" bindtap="copyVideoLink">
        <text class="video-url" selectable>{{task.videoUrl}}</text>
        <view class="copy-btn">复制链接</view>
      </view>

      <view class="video-row" wx:if="{{task.videoCode}}" bindtap="copyVideoCode">
        <text class="video-code" selectable>提取码 {{task.videoCode}}</text>
        <view class="copy-btn">复制提取码</view>
      </view>

      <text class="video-hint">微信内不能直接打开网盘链接：点一下复制，再到网盘 App 或浏览器粘贴打开</text>

      <view class="video-edit" wx:if="{{canManage}}" catchtap="openVideoEdit">修改视频</view>
    </view>

    <!-- 视频失效反馈：所有人可见（含管理，便于自测） -->
    <view class="report-bar" wx:if="{{task.videoUrl}}">
      <view class="report-btn" wx:if="{{!myReported}}" bindtap="openReport">⚠️ 视频打不开？反馈给管理</view>
      <view class="report-done" wx:else>✔ 已反馈，等待管理员处理</view>
    </view>

    <view class="video-add" wx:elif="{{canManage}}" bindtap="openVideoEdit">📺 添加视频讲解</view>

    <!-- 我的概览 -->
    <view class="card">
      <view class="row">
        <text class="k">我的定线</text>
        <text class="v line">{{me.line}}{{me.lineIsHistorical ? '（当时）' : ''}}{{me.lineSource === 'default' ? '（未定线，按娱乐）' : ''}}</text>
      </view>
      <view class="row">
        <text class="k">及格目标</text>
        <text class="v strong">{{me.targetLevel}} {{me.targetText || '未设该档'}}</text>
      </view>
      <view class="row">
        <text class="k">超线线</text>
        <text class="v">{{me.overLevel || '—'}} {{me.overText || ''}}</text>
      </view>
      <view class="row">
        <text class="k">当前最佳</text>
        <text class="v">{{me.bestText || '—'}}</text>
      </view>
      <view class="row">
        <text class="k">判定</text>
        <text class="v status {{me.status}}">{{me.statusText}}</text>
      </view>
    </view>

    <!-- 分线表（默认收起） -->
    <view class="section-title" bindtap="toggleLineTable">
      <text>分线表</text>
      <text class="toggle-hint">{{showLineTable ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view class="card" wx:if="{{showLineTable}}">
      <view class="line-row {{item.level === me.targetLevel ? 'is-target' : ''}}" wx:for="{{task.lineTable}}" wx:key="level">
        <text class="line-level">{{item.level}}</text>
        <text class="line-time">{{item.timeText || '未设'}}</text>
        <text class="line-tag" wx:if="{{item.level === me.targetLevel}}">我的目标</text>
        <text class="line-tag over" wx:elif="{{item.level === me.overLevel}}">超线</text>
      </view>
    </view>

    <!-- 曲线 -->
    <view class="section-title">进步曲线</view>
    <view class="card chart-card">
      <view class="chart-wrap" wx:if="{{myRecords.length >= 2}}">
        <canvas type="2d" id="curve" class="curve"></canvas>
        <view class="legend">
          <text class="legend-item"><text class="legend-dot target"></text>目标线</text>
          <text class="legend-item"><text class="legend-dot line"></text>我的成绩</text>
        </view>
      </view>
      <view class="chart-empty" wx:else>
        <text>{{myRecords.length === 0 ? '还没有成绩记录' : '至少 2 条记录才能画曲线'}}</text>
      </view>
    </view>

    <!-- 我的记录（默认收起） -->
    <view class="section-title" bindtap="toggleRecords">
      <text>我的记录 ({{myRecords.length}})</text>
      <text class="toggle-hint">{{showRecords ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view class="card" wx:if="{{showRecords}}">
      <view class="rec-row" wx:for="{{myRecords}}" wx:key="recordedAt">
        <text class="rec-date">{{item.recordDate || '未注日期'}}</text>
        <text class="rec-score">{{item.scoreText}}</text>
      </view>
      <view class="empty-line" wx:if="{{myRecords.length === 0}}"><text>暂无记录，可点下方「申请录入成绩」提交</text></view>
    </view>

    <!-- 反馈视频失效 -->
  <view class="modal-mask" wx:if="{{showReport}}" bindtap="closeReport">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">反馈视频失效</view>
      <view class="form-item">
        <text class="label">说明（选填）</text>
        <input class="input" placeholder="例如：提示分享已过期" value="{{reportNote}}" bindinput="onReportNote"/>
      </view>
      <view class="hint-line">管理员会看到这条反馈，更新视频后自动标记为已处理</view>
      <view class="modal-buttons">
        <view class="btn cancel" bindtap="closeReport">取消</view>
        <view class="btn confirm {{reporting ? 'disabled' : ''}}" bindtap="submitReport">提交反馈</view>
      </view>
    </view>
  </view>

  <!-- 修改视频讲解 -->
  <view class="modal-mask" wx:if="{{showVideoEdit}}" bindtap="closeVideoEdit">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">📺 视频讲解</view>

      <scroll-view scroll-y="true" class="modal-body">
        <view class="form-item">
          <text class="label">粘贴网盘分享内容</text>
          <textarea class="textarea" placeholder="从网盘复制整段内容粘贴，自动识别链接和提取码" value="{{videoText}}" bindinput="onVideoTextInput"/>
        </view>

        <view class="hint-line" wx:if="{{videoPlatform}}">已识别：{{videoPlatform}}</view>

        <view class="form-item">
          <text class="label">链接</text>
          <input class="input" value="{{videoUrl}}" data-field="videoUrl" bindinput="onVideoFieldInput" placeholder="自动识别，可手改"/>
        </view>

        <view class="form-item">
          <text class="label">提取码</text>
          <input class="input" value="{{videoCode}}" data-field="videoCode" bindinput="onVideoFieldInput" placeholder="选填，可手改"/>
        </view>

        <view class="form-item">
          <text class="label">说明</text>
          <input class="input" value="{{videoNote}}" data-field="videoNote" bindinput="onVideoFieldInput" placeholder="例如：第47期 跑法讲解"/>
        </view>
      </scroll-view>

      <view class="modal-buttons">
        <view class="btn cancel" bindtap="closeVideoEdit">取消</view>
        <view class="btn confirm" bindtap="saveVideo">保存</view>
      </view>
    </view>
  </view>

  <!-- 申请录入成绩 -->
    <view class="apply-row" wx:if="{{!settled}}">
      <view class="apply-btn" bindtap="openApply">📝 申请录入成绩</view>
      <text class="apply-hint">提交后需师傅或管理员审批，通过才写入成绩</text>
    </view>

    <!-- 我的申请（默认收起，展开时才查询） -->
    <view class="section-title" bindtap="toggleRequests">
      <text>我的申请</text>
      <text class="toggle-hint">{{showRequests ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view class="card" wx:if="{{showRequests}}">
      <view class="rec-row" wx:for="{{myRequests}}" wx:key="requestId">
        <text class="rec-date">{{item.recordDate || '未注日期'}}</text>
        <text class="rec-score">{{item.scoreText}}</text>
        <text class="req-status {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="empty-line" wx:if="{{requestsLoading}}"><text>加载中...</text></view>
      <view class="empty-line" wx:elif="{{myRequests.length === 0}}"><text>还没有提交过申请</text></view>
    </view>

    <!-- 榜单：已录入按成绩排序，未录入默认隐藏 -->
    <view class="section-title" bindtap="toggleBoard">
      <text>全员榜单 ({{boardDone.length}}/{{board.length}})</text>
      <text class="toggle-hint">{{boardOpen ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view class="card" wx:if="{{boardOpen}}">
      <view class="board-row" wx:for="{{boardDone}}" wx:key="openid" bindtap="openMember" data-openid="{{item.openid}}">
        <text class="board-rank">{{index + 1}}</text>
        <view class="board-who">
          <text class="board-name">{{item.gameName}}</text>
          <text class="board-line">{{item.line}}</text>
        </view>
        <text class="board-best">{{item.bestText || '—'}}</text>
        <text class="board-status {{item.status}}">{{item.statusText}}</text>
        <text class="board-arrow">›</text>
      </view>

      <view class="empty-line" wx:if="{{boardDone.length === 0}}">
        <text>还没有人录入成绩</text>
      </view>

      <view class="undone-toggle" wx:if="{{boardUndone.length > 0}}" bindtap="toggleUndone">
        <text>未完成名单 {{boardUndone.length}} 人</text>
        <text class="undone-arrow">{{showUndone ? '收起 ▲' : '查看 ▼'}}</text>
      </view>

      <block wx:if="{{showUndone}}">
        <view class="board-row undone" wx:for="{{boardUndone}}" wx:key="openid" bindtap="openMember" data-openid="{{item.openid}}">
          <text class="board-rank">—</text>
          <view class="board-who">
            <text class="board-name">{{item.gameName}}</text>
            <text class="board-line">{{item.line}}</text>
          </view>
          <text class="board-best">—</text>
          <text class="board-status {{item.status}}">{{item.statusText}}</text>
          <text class="board-arrow">›</text>
        </view>
      </block>
    </view>

    <!-- 管理操作 -->
    <view class="actions" wx:if="{{canManage}}">
      <view class="btn ghost" bindtap="goScores">代录成绩</view>
      <view class="btn confirm" wx:if="{{!settled}}" bindtap="closeTask">结束并结算</view>
    </view>
  </block>

  <!-- 申请录入成绩 -->
  <view class="modal-mask" wx:if="{{showApply}}" bindtap="closeApply">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">📝 申请录入成绩</view>

      <view class="form-item">
        <text class="label">日期（可选）</text>
        <view class="date-row">
          <picker mode="date" value="{{applyDate || today}}" bindchange="onApplyDate">
            <view class="picker-value">
              <text>{{applyDate || '不指定日期'}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <text class="clear-date" wx:if="{{applyDate}}" bindtap="clearApplyDate">不指定</text>
        </view>
      </view>

      <view class="form-item">
        <text class="label">成绩</text>
        <input class="input" placeholder="例如 1:27.99" value="{{applyScore}}" bindinput="onApplyScore"/>
      </view>

      <view class="hint-line">同一天已有成绩时，审批通过会覆盖原成绩</view>

      <view class="modal-buttons">
        <view class="btn cancel" bindtap="closeApply">取消</view>
        <view class="btn confirm {{submitting ? 'disabled' : ''}}" bindtap="submitApply">提交申请</view>
      </view>
    </view>
  </view>

  <!-- 某人成绩 -->
  <view class="modal-mask" wx:if="{{showMember}}" bindtap="closeMember">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">{{memberDetail.gameName}}<text class="modal-sub"> · {{memberDetail.line}}</text></view>

      <scroll-view scroll-y="true" class="modal-body">
        <view class="m-stats">
          <text class="m-status {{memberStatusClass}}">{{memberStatus}}</text>
          <text class="m-best">最佳 {{memberBest || '—'}}</text>
          <text class="m-target">目标 {{memberTargetLevel}} {{memberTargetText || '未设'}}</text>
        </view>

        <view class="chart-wrap" wx:if="{{memberRecords.length >= 2}}">
          <canvas type="2d" id="curveMember" class="curve"></canvas>
        </view>
        <view class="chart-empty" wx:else>
          <text>{{memberRecords.length === 0 ? '没有记录' : '只有 1 条记录，无法画曲线'}}</text>
        </view>

        <view class="rec-list">
          <view class="rec-row" wx:for="{{memberRecords}}" wx:key="recordedAt">
            <text class="rec-date">{{item.recordDate || '未注日期'}}</text>
            <text class="rec-score">{{item.scoreText}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="modal-close" catchtap="closeMember">关闭</view>
    </view>
  </view>

</view>
