/* pages/disciples/task/task.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 头部 */
.hero {
  padding: 34rpx 30rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(85, 37, 131, 0.25);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-map {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.hero-badge {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #552583;
  background: #FDB927;
  border-radius: 20rpx;
}

.hero-range {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 卡片 */
.card {
  margin-top: 20rpx;
  padding: 6rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.row:last-child {
  border-bottom: none;
}

.k {
  font-size: 26rpx;
  color: #888;
}

.v {
  font-size: 27rpx;
  color: #333;
  text-align: right;
}

.v.strong {
  color: #552583;
  font-weight: 600;
}

.v.line {
  color: #FDB927;
  font-weight: 600;
}

.v.status.over { color: #b8860b; font-weight: 600; }
.v.status.passed { color: #2e7d32; font-weight: 600; }
.v.status.missed { color: #c0392b; font-weight: 600; }
.v.status.absent { color: #999; font-weight: 600; }
.v.status.pending { color: #2980b9; font-weight: 600; }

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 6rpx 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.toggle-hint {
  font-size: 22rpx;
  font-weight: normal;
  color: #999;
}

/* 分线表 */
.line-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.line-row:last-child {
  border-bottom: none;
}

.line-level {
  width: 150rpx;
  font-size: 26rpx;
  color: #666;
}

.line-time {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.line-row.is-target .line-time {
  color: #552583;
  font-weight: 600;
}

.line-tag {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #fff;
  background: #552583;
  border-radius: 16rpx;
}

.line-tag.over {
  color: #7a5200;
  background: rgba(253, 185, 39, 0.7);
}

/* 曲线 */
.chart-card {
  padding: 20rpx 20rpx 10rpx;
}

.chart-wrap {
  width: 100%;
}

.curve {
  width: 100%;
  height: 300rpx;
}

.legend {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 4rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 20rpx;
  font-size: 20rpx;
  color: #999;
}

.legend-dot {
  width: 16rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.legend-dot.target {
  background: #FDB927;
}

.legend-dot.line {
  background: #552583;
}

.chart-empty {
  padding: 70rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

/* 记录 */
.rec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.rec-row:last-child {
  border-bottom: none;
}

.rec-date {
  font-size: 25rpx;
  color: #888;
}

.rec-score {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.empty-line {
  padding: 36rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

/* 榜单 */
.board-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.board-row:last-child {
  border-bottom: none;
}

.board-rank {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #bbb;
}

.board-who {
  flex: 1;
  display: flex;
  align-items: center;
}

.board-name {
  font-size: 27rpx;
  color: #333;
}

.board-line {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #552583;
  background: rgba(85, 37, 131, 0.08);
  border-radius: 14rpx;
}

.board-best {
  width: 150rpx;
  text-align: right;
  font-size: 26rpx;
  color: #333;
}

.board-status {
  width: 130rpx;
  text-align: right;
  font-size: 22rpx;
  color: #999;
}

.board-status.over { color: #b8860b; }
.board-status.passed { color: #2e7d32; }
.board-status.missed { color: #c0392b; }
.board-status.absent { color: #bbb; }

/* 操作 */
.actions {
  display: flex;
  margin-top: 40rpx;
}

.actions .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
}

.btn.ghost {
  color: #552583;
  background: #fff;
  border: 2rpx solid rgba(85, 37, 131, 0.2);
}

.btn.confirm {
  color: #fff;
  background: linear-gradient(135deg, #552583, #3d1e63);
}

/* 榜单可点提示 */
.board-arrow {
  margin-left: 6rpx;
  font-size: 26rpx;
  color: #ccc;
}

/* 曲线高度加大，容纳成绩与日期标签 */
.curve {
  height: 380rpx;
}

/* 成员成绩弹层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.modal {
  width: 640rpx;
  max-height: 82vh;
  padding: 36rpx 0 16rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding-bottom: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-sub {
  font-size: 24rpx;
  font-weight: normal;
  color: #FDB927;
}

.modal-body {
  max-height: 58vh;
  padding: 10rpx 0;
}

.m-stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 16rpx 30rpx;
}

.m-status {
  padding: 6rpx 18rpx;
  margin-right: 18rpx;
  font-size: 22rpx;
  border-radius: 16rpx;
  color: #666;
  background: #f2f2f2;
}

.m-status.over { color: #7a5200; background: rgba(253, 185, 39, 0.3); }
.m-status.passed { color: #2e7d32; background: rgba(46, 125, 50, 0.12); }
.m-status.missed { color: #c0392b; background: rgba(192, 57, 43, 0.12); }

.m-best {
  font-size: 28rpx;
  font-weight: 600;
  color: #552583;
  margin-right: 16rpx;
}

.m-target {
  font-size: 23rpx;
  color: #999;
}

.rec-list {
  padding: 0 30rpx;
}

.modal-close {
  margin: 16rpx 30rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
}

/* 未完成名单 */
.undone-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding: 24rpx 8rpx;
  font-size: 24rpx;
  color: #999;
  border-top: 2rpx solid #f7f7f7;
}

.undone-arrow {
  color: #552583;
}

.board-row.undone .board-name {
  color: #888;
}

/* 成绩申请 */
.apply-row {
  margin-top: 30rpx;
}

.apply-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FDB927, #f5a623);
  box-shadow: 0 6rpx 16rpx rgba(253, 185, 39, 0.3);
}

.apply-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 21rpx;
  color: #bbb;
}

.req-status {
  width: 110rpx;
  text-align: right;
  font-size: 22rpx;
  color: #999;
}

.req-status.pending { color: #2980b9; }
.req-status.approved { color: #2e7d32; }
.req-status.rejected { color: #c0392b; }

/* 申请弹窗表单 */
.form-item {
  padding: 22rpx 30rpx 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #666;
}

.input {
  height: 76rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.date-row {
  display: flex;
  align-items: center;
}

.clear-date {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999;
  text-decoration: underline;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  font-size: 27rpx;
  color: #552583;
  font-weight: 600;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 10rpx;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #999;
}

.hint-line {
  padding: 18rpx 30rpx 0;
  font-size: 21rpx;
  color: #bbb;
}

.modal-buttons {
  display: flex;
  padding: 26rpx 30rpx 8rpx;
}

.modal-buttons .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.btn.confirm {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
}

.btn.disabled {
  opacity: 0.6;
}

/* 视频讲解 */
.video-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #FDB927;
}

.video-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.video-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.video-platform {
  font-size: 21rpx;
  color: #7a5200;
  background: rgba(253, 185, 39, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.video-note {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #888;
}

.video-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.video-url {
  flex: 1;
  font-size: 22rpx;
  color: #552583;
  word-break: break-all;
  margin-right: 16rpx;
}

.video-code {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  letter-spacing: 1rpx;
}

.copy-btn {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #552583, #3d1e63);
  border-radius: 20rpx;
}

.video-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #bbb;
  line-height: 1.6;
}

.video-edit {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f7f7f7;
  text-align: right;
  font-size: 23rpx;
  color: #552583;
}

.video-add {
  margin-top: 20rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 26rpx;
  color: #552583;
  background: #fff;
  border: 2rpx dashed rgba(85, 37, 131, 0.35);
  border-radius: 16rpx;
}

/* 视频编辑弹窗的文本域 */
.textarea {
  width: 100%;
  height: 150rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 10rpx;
}

/* 视频失效反馈 */
.report-bar {
  margin-top: 16rpx;
}

.report-btn {
  padding: 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: #c0392b;
  background: #fff;
  border: 2rpx dashed rgba(192, 57, 43, 0.4);
  border-radius: 14rpx;
}

.report-done {
  padding: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  background: #fff;
  border-radius: 14rpx;
}

/* 地图笔记 PDF */
.doc-card {
  margin-top: 20rpx;
  padding: 8rpx 26rpx 8rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #2f7d6b;
}

.doc-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.doc-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.doc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.doc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #2f7d6b;
}

.doc-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #aaa;
}

.doc-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.doc-edit {
  padding: 14rpx 0;
  border-top: 2rpx solid #f7f7f7;
  text-align: right;
  font-size: 23rpx;
  color: #552583;
}

.doc-add {
  margin-top: 20rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2f7d6b;
  background: #fff;
  border: 2rpx dashed rgba(47, 125, 107, 0.4);
  border-radius: 16rpx;
}

/* 榜单筛选 */
.board-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0 10rpx;
  border-bottom: 2rpx solid #f7f7f7;
}

.bf-item {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 20rpx;
}

.bf-item.on {
  color: #fff;
  background: #552583;
}

.bf-item.over.on { background: #b8860b; }
.bf-item.passed.on { background: #2e7d32; }
.bf-item.missed.on { background: #c0392b; }
.bf-item.absent.on { background: #888; }
