/* pages/disciples/disciples.wxss */
/* 主演徒弟首页 —— 紫金主题，只做概览与入口 */

page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 加载 ---------- */
.loading-box {
  padding-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* ---------- 非徒弟 ---------- */
.lock-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 0;
}

.lock-avatar {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, rgba(253, 185, 39, 0.22), rgba(85, 37, 131, 0) 68%);
}

.lock-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.lock-desc {
  max-width: 560rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  margin-bottom: 60rpx;
  text-align: center;
  line-height: 1.75;
}

.apply-btn {
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
  box-shadow: 0 8rpx 20rpx rgba(85, 37, 131, 0.3);
}

.claim-btn {
  margin-top: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  color: #552583;
  border: 2rpx solid #552583;
  border-radius: 40rpx;
}

/* ---------- 师傅卡片 ---------- */
.master-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 30rpx 0;
  padding: 26rpx 30rpx;
  background: linear-gradient(135deg, #fff8e6, #ffffff);
  border: 2rpx solid rgba(253, 185, 39, 0.45);
  border-radius: 16rpx;
}

.master-left {
  display: flex;
  align-items: center;
}

.master-avatar {
  width: 92rpx;
  height: 92rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 3rpx solid rgba(253, 185, 39, 0.85);
  box-sizing: border-box;
}

.master-text {
  display: flex;
  flex-direction: column;
}

.master-tag {
  align-self: flex-start;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #7a5200;
  background: rgba(253, 185, 39, 0.25);
  border-radius: 8rpx;
}

.master-name {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.master-game {
  font-size: 24rpx;
  color: #999;
}

/* ---------- 我的定线 ---------- */
.line-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 30rpx 0;
  padding: 32rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.line-main {
  display: flex;
  flex-direction: column;
}

.line-label {
  font-size: 24rpx;
  color: #999;
}

.line-value {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: bold;
  color: #FDB927;
  line-height: 1.2;
}

.line-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c0392b;
}

.role-badge {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #666;
  background: #f2f2f2;
  border-radius: 24rpx;
}

.role-badge.is-master {
  color: #7a5200;
  background: rgba(253, 185, 39, 0.25);
}

.role-badge.is-admin {
  color: #552583;
  background: rgba(85, 37, 131, 0.1);
}

/* ---------- 区块 ---------- */
.section {
  margin: 30rpx 30rpx 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* ---------- 任务卡片 ---------- */
.task-card {
  padding: 26rpx 30rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #552583;
}

.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.task-map {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.task-days {
  font-size: 24rpx;
  color: #c0392b;
}

.task-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}

.task-k {
  font-size: 25rpx;
  color: #999;
}

.task-v {
  font-size: 25rpx;
  color: #333;
}

.task-v.strong {
  color: #552583;
  font-weight: 600;
}

/* ---------- 空状态 ---------- */
.empty-box {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  background: #fff;
  border-radius: 16rpx;
}

/* ---------- 入口 ---------- */
.entry-grid {
  display: flex;
  margin: 30rpx 30rpx 0;
}

.entry {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 10rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.entry + .entry {
  margin-left: 20rpx;
}

.entry-icon {
  font-size: 48rpx;
}

.entry-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.entry-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* ---------- 分享 ---------- */
.share-row {
  padding: 30rpx 30rpx 0;
}

.share-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
  color: #552583;
  background: #ffffff;
  border: 2rpx solid rgba(85, 37, 131, 0.15);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.share-btn::after {
  border: none;
}

.share-btn.ghost {
  width: 420rpx;
  margin-top: 32rpx;
  background: transparent;
  border: 2rpx solid rgba(85, 37, 131, 0.45);
  box-shadow: none;
}

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.modal {
  width: 620rpx;
  max-height: 80vh;
  padding: 40rpx 0 20rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding-bottom: 24rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-item {
  padding: 20rpx 40rpx 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.input {
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.modal-buttons {
  display: flex;
  padding: 30rpx 40rpx 10rpx;
}

.modal-buttons .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.btn.confirm {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
}

/* ---------- 朋友圈单页模式 ---------- */
.single-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 0;
}

.single-hint {
  margin-top: 40rpx;
  padding: 20rpx 30rpx;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
  color: #7a6a90;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 12rpx;
}

/* 入口红点 */
.entry-badge {
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #e74c3c;
  border-radius: 17rpx;
}

/* 朋友圈单页模式：形象略小，避免顶满 */
.lock-avatar.small {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

/* ---------- 演门公告 ---------- */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 30rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff9ec, #fffdf7);
  border: 2rpx solid rgba(253, 185, 39, 0.35);
  border-left: 6rpx solid #FDB927;
  border-radius: 14rpx;
}

.notice-left {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.notice-label {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
  font-size: 20rpx;
  color: #7a5200;
  background: rgba(253, 185, 39, 0.28);
  border-radius: 8rpx;
}

.notice-text {
  flex: 1;
  font-size: 25rpx;
  color: #5a4200;
  line-height: 1.5;
  word-break: break-all;
}

.notice-text.muted {
  color: #b8a97e;
}

.notice-edit {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
}

.notice-empty {
  background: #fff;
  border-color: rgba(0, 0, 0, 0.06);
  border-left-color: #e3dcc9;
}

/* ---------- 分线变化 ---------- */
.line-history {
  margin: 16rpx 30rpx 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.lh-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.lh-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.lh-item {
  display: flex;
  align-items: center;
  margin: 0 18rpx 8rpx 0;
}

.lh-line {
  padding: 6rpx 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #552583;
  background: rgba(85, 37, 131, 0.08);
  border-radius: 8rpx;
}

.lh-date {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #bbb;
}

/* 阳门门主：仅身份展示，权限等同徒弟 */
.role-badge.is-yang {
  color: #0b6b5b;
  background: rgba(11, 107, 91, 0.12);
}

/* 阳门弟子：同样只是身份展示 */
.role-badge.is-yang-disciple {
  color: #2f7d6b;
  background: rgba(47, 125, 107, 0.1);
}
