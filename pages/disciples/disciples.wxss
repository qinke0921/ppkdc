/* pages/disciples/disciples.wxss */
/* 主演徒弟模块 —— 独立配色（紫金），与车队的蓝色区分开 */

page {
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 加载 ---------- */
.loading-box {
  padding-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* ---------- 非徒弟：申请入口 ---------- */
.lock-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 0;
}

.lock-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.lock-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.lock-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
  text-align: center;
}

.apply-btn {
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
  box-shadow: 0 8rpx 20rpx rgba(85, 37, 131, 0.3);
}

.claim-btn {
  margin-top: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  color: #552583;
  border: 2rpx solid #552583;
  border-radius: 40rpx;
}

/* ---------- 欢迎条 ---------- */
.welcome {
  position: relative;
  margin: 30rpx;
  padding: 36rpx 40rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #552583, #7b3fa0);
  box-shadow: 0 10rpx 24rpx rgba(85, 37, 131, 0.25);
}

.welcome-text {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.welcome-sub {
  display: block;
  margin-top: 10rpx;
  color: #FDB927;
  font-size: 26rpx;
}

/* ---------- 统计卡 ---------- */
.stat-row {
  display: flex;
  margin: 0 30rpx;
  gap: 20rpx;
}

.stat-card + .stat-card {
  margin-left: 20rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 10rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #552583;
}

.line-num {
  font-size: 30rpx;
  color: #FDB927;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* ---------- 管理员入口 ---------- */
.admin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 30rpx 30rpx 0;
  height: 84rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FDB927, #f5a623);
  box-shadow: 0 6rpx 16rpx rgba(253, 185, 39, 0.3);
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #e74c3c;
  border-radius: 18rpx;
}

/* ---------- 名单 ---------- */
.members-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 30rpx;
  padding: 26rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.member-list {
  margin: 0 30rpx;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-game {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.member-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.line-badge {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #552583;
  font-weight: 600;
  background: rgba(85, 37, 131, 0.08);
  border-radius: 24rpx;
}

.line-badge.empty {
  color: #bbb;
  background: #f2f2f2;
  font-weight: normal;
}

.empty-hint {
  display: block;
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}

/* ---------- 弹窗通用 ---------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.modal {
  width: 620rpx;
  max-height: 80vh;
  padding: 40rpx 0 20rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding-bottom: 24rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-item {
  padding: 20rpx 40rpx 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.input {
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 40rpx 10rpx;
}

.modal-buttons .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.btn.confirm {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
}

.btn.edit {
  background: linear-gradient(135deg, #FDB927, #f5a623);
  color: #fff;
}

.modal-close {
  margin: 20rpx 40rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
}

/* ---------- 审批列表 ---------- */
.app-list {
  max-height: 56vh;
  padding: 10rpx 0;
}

.app-item {
  padding: 26rpx 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.app-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.app-game {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.app-statement {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.app-date {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.line-pick {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #552583;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 12rpx;
}

.picker-arrow {
  color: #999;
}

/* ---------- 详情 ---------- */
.detail-content {
  max-height: 52vh;
  padding: 10rpx 0;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 40rpx;
  border-bottom: 2rpx solid #f7f7f7;
}

.detail-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 26rpx;
  color: #888;
}

.detail-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.detail-value.no-data {
  color: #ccc;
}

.detail-value.role-admin {
  color: #FDB927;
  font-weight: 600;
}

.detail-value.line-value {
  color: #552583;
  font-weight: 600;
}

.edit-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  text-align: right;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
}

.edit-textarea {
  flex: 1;
  height: 120rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
}

.picker-value text + text {
  margin-left: 10rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #552583;
  font-weight: 600;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 10rpx;
}

/* ---------- 师傅（主演）卡片 ---------- */
.master-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 30rpx 0;
  padding: 26rpx 30rpx;
  background: linear-gradient(135deg, #fff8e6, #ffffff);
  border: 2rpx solid rgba(253, 185, 39, 0.45);
  border-radius: 16rpx;
}

.master-left {
  display: flex;
  align-items: center;
}

.master-tag {
  padding: 6rpx 16rpx;
  margin-right: 16rpx;
  font-size: 22rpx;
  color: #7a5200;
  background: rgba(253, 185, 39, 0.25);
  border-radius: 8rpx;
}

.master-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.master-game {
  font-size: 24rpx;
  color: #999;
}

.detail-value.role-master {
  color: #b8860b;
  font-weight: 600;
}

/* ---------- 分享按钮 ---------- */
.share-row {
  padding: 20rpx 30rpx 0;
}

.share-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
  color: #552583;
  background: #ffffff;
  border: 2rpx solid rgba(85, 37, 131, 0.15);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 去掉小程序 button 默认边框 */
.share-btn::after {
  border: none;
}

.share-btn.ghost {
  width: 420rpx;
  margin-top: 32rpx;
  background: transparent;
  border: 2rpx solid rgba(85, 37, 131, 0.45);
  box-shadow: none;
}

/* ---------- 朋友圈单页模式 ---------- */
.single-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 0;
}

.single-hint {
  margin-top: 40rpx;
  padding: 20rpx 30rpx;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
  color: #7a6a90;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 12rpx;
}
