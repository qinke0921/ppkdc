<!--pages/disciples/history/history.wxml-->
<view class="page">
  <view class="loading-box" wx:if="{{loading}}"><text>加载中...</text></view>

  <block wx:else>
    <view class="target-banner" wx:if="{{targetName}}">
      <text>{{targetName}} 的任务历史</text>
    </view>

    <view class="summary-card" wx:if="{{summary}}">
      <view class="sum-item">
        <text class="sum-num over">{{summary.over}}</text>
        <text class="sum-label">超线</text>
      </view>
      <view class="sum-item">
        <text class="sum-num passed">{{summary.passed}}</text>
        <text class="sum-label">达标</text>
      </view>
      <view class="sum-item">
        <text class="sum-num missed">{{summary.missed}}</text>
        <text class="sum-label">未达标</text>
      </view>
      <view class="sum-item">
        <text class="sum-num absent">{{summary.absent}}</text>
        <text class="sum-label">逃课</text>
      </view>
    </view>
    <text class="summary-total" wx:if="{{summary}}">共 {{summary.total}} 期</text>

    <view class="filter-bar">
      <text class="filter-count">共 {{allList.length}} 期</text>
      <view class="filter-chip {{onlyMine ? 'on' : ''}}" bindtap="toggleOnlyMine">
        <text>{{onlyMine ? '只看有记录的' : '显示全部'}}</text>
      </view>
    </view>

    <view class="card {{item.hasResult ? '' : 'no-result'}}" wx:for="{{list}}" wx:key="taskId" bindtap="goTask" data-id="{{item.taskId}}">
      <view class="top">
        <text class="map">{{item.mapName}}</text>
        <text class="status {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="meta">
        <text class="range">{{item.rangeText}}</text>
        <text class="best">{{item.bestText || '无记录'}}</text>
      </view>
      <view class="sub" wx:if="{{item.beforeJoin}}">当时还没拜师</view>
      <view class="sub" wx:elif="{{item.hasResult}}">目标 {{item.targetLevel}} {{item.targetText || '未设'}} · {{item.recordCount}} 条记录</view>
      <view class="sub muted" wx:else>本期没有我的成绩，可点进去看别人的记录</view>
    </view>

    <view class="empty-box" wx:if="{{list.length === 0}}">
      <text>还没有已结算的任务</text>
    </view>
  </block>
</view>
