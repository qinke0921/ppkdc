<!--pages/disciples/disciples.wxml-->
<!-- 首页只做概览与入口，具体功能进独立页面 -->
<view class="container">

  <!-- 朋友圈单页模式：无登录态，只做静态介绍 -->
  <block wx:if="{{singlePageMode}}">
    <view class="single-page">
      <image class="lock-avatar small" src="/images/star-lock.png" mode="aspectFit"/>
      <text class="lock-title">主演徒弟</text>
      <text class="lock-desc">拜师申请 · 实力定线</text>
      <view class="single-hint">点击底部「前往小程序」，查看徒弟名单并提交拜师申请</view>
    </view>
  </block>

  <view class="loading-box" wx:elif="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 非徒弟 -->
  <block wx:elif="{{!isDisciple}}">
    <view class="lock-section">
      <image class="lock-avatar" src="/images/star-lock.png" mode="aspectFit"/>
      <text class="lock-title">主演徒弟</text>
      <text class="lock-desc">本页面仅限主演徒弟使用，拜师请联系主演。已拜师请提交拜师申请，通过后即可查看…</text>
      <view class="apply-btn" bindtap="showApplyModal">
        <text>申请拜师</text>
      </view>
      <button class="share-btn ghost" open-type="share">
        <text>分享给好友</text>
      </button>
      <view class="claim-btn" wx:if="{{canClaimMaster}}" bindtap="claimMaster">
        <text>初始化师傅</text>
      </view>
    </view>
  </block>

  <!-- 徒弟专区：概览 -->
  <block wx:else>
    <!-- 师傅 -->
    <view class="master-card" wx:if="{{masterInfo}}">
      <view class="master-left">
        <image class="master-avatar" src="/images/star-avatar.png" mode="aspectFill"/>
        <view class="master-text">
          <text class="master-tag">👑 师傅</text>
          <text class="master-name">{{masterInfo.nickname || '主演'}}</text>
        </view>
      </view>
      <text class="master-game">{{masterInfo.gameName || ''}}</text>
    </view>

    <!-- 我的定线 -->
    <view class="line-card">
      <view class="line-main">
        <text class="line-label">我的定线</text>
        <text class="line-value">{{discipleInfo.masterLine}}</text>
        <text class="line-hint" wx:if="{{discipleInfo.lineSource === 'default'}}">未定线，按娱乐档计算</text>
      </view>
      <view class="role-badge {{isMaster ? 'is-master' : (isAdmin ? 'is-admin' : (isYangLeader ? 'is-yang' : (isYangDisciple ? 'is-yang-disciple' : '')))}}">
        <text>{{isMaster ? '👑 师傅' : (isAdmin ? '⭐ 管理员' : (isYangLeader ? '🐲 阳门门主' : (isYangDisciple ? '🥋 阳门弟子' : '👤 徒弟')))}}</text>
      </view>
    </view>

    <!-- 分线变化 -->
    <view class="line-history" wx:if="{{lineHistory.length > 0}}">
      <text class="lh-title">分线变化</text>
      <view class="lh-list">
        <view class="lh-item" wx:for="{{lineHistory}}" wx:key="at">
          <text class="lh-line">{{item.line}}</text>
          <text class="lh-date">{{item.dateText}}</text>
        </view>
      </view>
    </view>

    <!-- 演门公告 -->
    <view class="notice" wx:if="{{announcement.content}}">
      <view class="notice-left">
        <text class="notice-label">演门公告</text>
        <text class="notice-text">{{announcement.content}}</text>
      </view>
      <text class="notice-edit" wx:if="{{canManage}}" catchtap="openAnnounceEdit">✏️</text>
    </view>

    <view class="notice notice-empty" wx:elif="{{canManage}}" bindtap="openAnnounceEdit">
      <view class="notice-left">
        <text class="notice-label">演门公告</text>
        <text class="notice-text muted">点此写一句话公告</text>
      </view>
      <text class="notice-edit">✏️</text>
    </view>

    <!-- 进行中任务 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">📅 进行中</text>
        <text class="section-count" wx:if="{{activeTasks.length > 0}}">{{activeTasks.length}} 个任务</text>
      </view>

      <view class="task-card" wx:for="{{activeTasks}}" wx:key="taskId" bindtap="goTask" data-id="{{item.taskId}}">
        <view class="task-top">
          <text class="task-map">{{item.mapName}}</text>
          <text class="task-days">剩 {{item.daysLeft}} 天</text>
        </view>
        <view class="task-row">
          <text class="task-k">我的目标</text>
          <text class="task-v strong">{{item.targetLevel}} {{item.targetText}}</text>
        </view>
        <view class="task-row">
          <text class="task-k">当前最佳</text>
          <text class="task-v">{{item.bestText || '—'}}</text>
        </view>
        <view class="task-row">
          <text class="task-k">预计判定</text>
          <text class="task-v">{{item.statusText || '暂无记录'}}</text>
        </view>
      </view>

      <view class="empty-box" wx:if="{{activeTasks.length === 0}}">
        <text>暂无进行中的任务</text>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="entry-grid">
      <view class="entry" bindtap="goMembers">
        <text class="entry-icon">👥</text>
        <text class="entry-text">徒弟名单</text>
        <text class="entry-sub">{{discipleCount}} 人</text>
      </view>
      <view class="entry" bindtap="goHistory">
        <text class="entry-icon">📊</text>
        <text class="entry-text">任务历史</text>
        <text class="entry-sub">往期判定</text>
      </view>
      <view class="entry" wx:if="{{canManage}}" bindtap="goAdmin">
        <view class="entry-badge" wx:if="{{pendingTotal > 0}}">{{pendingTotal > 99 ? '99+' : pendingTotal}}</view>
        <text class="entry-icon">⚙️</text>
        <text class="entry-text">管理中心</text>
        <text class="entry-sub">{{pendingTotal > 0 ? pendingTotal + ' 项待审批' : '审批 · 任务'}}</text>
      </view>
    </view>

    <view class="share-row">
      <button class="share-btn" open-type="share">
        <text>🔗 分享给好友</text>
      </button>
    </view>
  </block>

  <!-- 编辑演门公告 -->
  <view class="modal-mask" wx:if="{{showAnnounce}}" bindtap="closeAnnounceEdit">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">演门公告</view>
      <view class="form-item">
        <text class="label">内容（最多 120 字，清空后公告会隐藏）</text>
        <textarea class="textarea" maxlength="120" placeholder="例如：本周作业先看视频讲解，再录成绩" value="{{announceText}}" bindinput="onAnnounceInput"/>
      </view>
      <view class="modal-buttons">
        <view class="btn cancel" bindtap="closeAnnounceEdit">取消</view>
        <view class="btn confirm {{savingAnnounce ? 'disabled' : ''}}" bindtap="saveAnnounce">保存</view>
      </view>
    </view>
  </view>

  <!-- 拜师申请弹窗 -->
  <view class="modal-mask" wx:if="{{showApplyModal}}" bindtap="hideApplyModal">
    <view class="modal" catchtap="stopPropagation">
      <view class="modal-title">📝 申请拜师</view>
      <view class="form-item">
        <text class="label">昵称</text>
        <input class="input" placeholder="请输入昵称" value="{{applyForm.nickname}}" data-field="nickname" bindinput="onInput"/>
      </view>
      <view class="form-item">
        <text class="label">游戏昵称</text>
        <input class="input" placeholder="游戏内名字" value="{{applyForm.gameName}}" data-field="gameName" bindinput="onInput"/>
      </view>
      <view class="form-item">
        <text class="label">游戏ID</text>
        <input class="input" placeholder="请输入游戏ID" value="{{applyForm.gameId}}" data-field="gameId" bindinput="onInput"/>
      </view>
      <view class="form-item">
        <text class="label">个人宣言</text>
        <textarea class="textarea" placeholder="介绍一下自己（选填）" value="{{applyForm.statement}}" data-field="statement" bindinput="onInput"/>
      </view>
      <view class="modal-buttons">
        <view class="btn cancel" bindtap="hideApplyModal">取消</view>
        <view class="btn confirm" bindtap="submitApplication">提交申请</view>
      </view>
    </view>
  </view>

</view>
