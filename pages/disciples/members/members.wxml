<!--pages/disciples/members/members.wxml-->
<view class="page">

  <view class="search-bar">
    <input class="search-input" placeholder="搜索昵称 / 游戏名 / 游戏ID" value="{{keyword}}" bindinput="onSearch" confirm-type="search"/>
    <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">✕</view>
  </view>

  <view class="list-head">
    <text class="list-count">共 {{total}} 人</text>
    <text class="list-hint">{{keyword ? '搜索中，命中分组已展开' : '点分组展开'}}</text>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="group-list" wx:else>
    <view class="group" wx:for="{{groups}}" wx:key="level">
      <view class="group-head" bindtap="toggleGroup" data-level="{{item.level}}">
        <view class="group-left">
          <text class="group-level">{{item.level}}</text>
          <text class="group-count">{{item.count}} 人</text>
        </view>
        <text class="group-arrow">{{item.open ? '收起 ▲' : '展开 ▼'}}</text>
      </view>

      <view class="group-body" wx:if="{{item.open}}">
        <view class="member-card" wx:for="{{item.members}}" wx:for-item="m" wx:key="_id" bindtap="goMember" data-id="{{m._id}}">
          <view class="member-info">
            <text class="member-game">{{m.gameName}}</text>
            <text class="member-name">{{m.nickname}}<text wx:if="{{m.role === 'master'}}"> · 师傅</text><text wx:elif="{{m.role === 'admin'}}"> · 管理员</text><text wx:elif="{{m.role === 'yang_leader'}}"> · 阳门门主</text></text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <view class="empty-box" wx:if="{{groups.length === 0}}">
      <text wx:if="{{keyword}}">没有匹配的徒弟</text>
      <text wx:else>还没有徒弟</text>
    </view>
  </view>

</view>
