<!--pages/disciples/members/members.wxml-->
<view class="page">

  <view class="search-bar">
    <input class="search-input" placeholder="搜索昵称 / 游戏名 / 游戏ID" value="{{keyword}}" bindinput="onSearch" confirm-type="search"/>
    <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">✕</view>
  </view>

  <view class="list-head">
    <text class="list-count">共 {{list.length}} 人</text>
    <view class="sort-btn" bindtap="toggleSort">
      <text>{{sortBy === 'line' ? '按定线排序' : '按名字排序'}}</text>
      <text class="sort-arrow">⇅</text>
    </view>
  </view>

  <view class="loading-box" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="member-list" wx:else>
    <view class="member-card" wx:for="{{list}}" wx:key="_id" bindtap="goMember" data-id="{{item._id}}">
      <view class="member-info">
        <text class="member-game">{{item.gameName}}</text>
        <text class="member-name">{{item.nickname}}<text wx:if="{{item.role === 'master'}}"> · 师傅</text><text wx:elif="{{item.role === 'admin'}}"> · 管理员</text></text>
      </view>
      <view class="line-badge {{item.masterLine ? '' : 'empty'}}">{{item.masterLine || '未定线'}}</view>
      <text class="arrow">›</text>
    </view>

    <view class="empty-box" wx:if="{{list.length === 0}}">
      <text wx:if="{{keyword}}">没有匹配的徒弟</text>
      <text wx:else>还没有徒弟</text>
    </view>
  </view>

</view>
