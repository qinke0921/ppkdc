/* pages/disciples/members/members.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 30rpx 0;
  padding: 0 24rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  padding: 10rpx;
  font-size: 26rpx;
  color: #bbb;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 30rpx 12rpx;
}

.list-count {
  font-size: 24rpx;
  color: #999;
}

.list-hint {
  font-size: 22rpx;
  color: #bbb;
}

.loading-box {
  padding-top: 120rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 分组 */
.group-list {
  margin: 0 30rpx;
}

.group {
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.group-left {
  display: flex;
  align-items: baseline;
}

.group-level {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.group-count {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: #999;
}

.group-arrow {
  font-size: 23rpx;
  color: #552583;
}

.group-body {
  border-top: 2rpx solid #f7f7f7;
  padding: 0 28rpx;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.member-card:last-child {
  border-bottom: none;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-game {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.member-name {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #999;
}

.arrow {
  font-size: 30rpx;
  color: #ccc;
}

.empty-box {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}
