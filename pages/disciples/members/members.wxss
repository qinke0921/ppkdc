/* pages/disciples/members/members.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 30rpx 0;
  padding: 0 24rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  padding: 10rpx;
  font-size: 26rpx;
  color: #bbb;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 30rpx 12rpx;
}

.list-count {
  font-size: 24rpx;
  color: #999;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #552583;
  background: rgba(85, 37, 131, 0.08);
  border-radius: 24rpx;
}

.sort-arrow {
  margin-left: 8rpx;
}

.loading-box {
  padding-top: 120rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.member-list {
  margin: 0 30rpx;
}

.member-card {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-game {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.member-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.line-badge {
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #552583;
  background: rgba(85, 37, 131, 0.08);
  border-radius: 24rpx;
}

.line-badge.empty {
  color: #bbb;
  background: #f2f2f2;
  font-weight: normal;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.empty-box {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}
