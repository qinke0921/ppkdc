/* pages/disciples/admin/scores/scores.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 180rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.head-map {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.head-stats {
  font-size: 24rpx;
  color: #999;
}

.bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.date-btn {
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  color: #552583;
  font-weight: 600;
  background: #fff;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.picker-arrow {
  margin-left: 10rpx;
  color: #999;
}

.clear-btn {
  margin-left: 16rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #999;
  background: #fff;
  border-radius: 30rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  background: #fff;
  border-radius: 30rpx;
}

.toggle {
  margin-left: 16rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #fff;
  border-radius: 30rpx;
}

.toggle.on {
  color: #fff;
  background: #552583;
}

.list {
  margin-top: 10rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 12rpx;
}

.who {
  display: flex;
  align-items: center;
  flex: 1;
}

.who-game {
  font-size: 27rpx;
  color: #333;
}

.who-line {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #552583;
  background: rgba(85, 37, 131, 0.08);
  border-radius: 16rpx;
}

.score-input {
  width: 200rpx;
  height: 64rpx;
  padding: 0 18rpx;
  text-align: right;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
}

.empty-box {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #552583, #3d1e63);
}

.save-btn.disabled {
  opacity: 0.6;
}
