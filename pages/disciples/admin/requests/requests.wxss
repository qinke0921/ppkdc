/* pages/disciples/admin/requests/requests.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.head-hint {
  font-size: 21rpx;
  color: #bbb;
}

.card {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.map {
  font-size: 23rpx;
  color: #999;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.k {
  font-size: 24rpx;
  color: #999;
}

.v {
  font-size: 26rpx;
  color: #333;
}

.v.strong {
  color: #552583;
  font-weight: 600;
}

.v.muted {
  color: #c0392b;
  font-size: 23rpx;
}

.actions {
  display: flex;
  margin-top: 18rpx;
}

.actions .btn + .btn {
  margin-left: 16rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn.reject {
  background: #f5f5f5;
  color: #666;
}

.btn.approve {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
}

.empty-box {
  padding: 100rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}
