/* pages/disciples/admin/admin.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.section {
  margin-bottom: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 待审批 */
.app-card {
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.app-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.app-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.app-date {
  font-size: 22rpx;
  color: #bbb;
}

.app-game {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.app-statement {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.line-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #552583;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 12rpx;
}

.picker-arrow {
  color: #999;
}

.app-actions {
  display: flex;
  margin-top: 20rpx;
}

.app-actions .btn + .btn {
  margin-left: 16rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn.reject {
  background: #f5f5f5;
  color: #666;
}

.btn.approve {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
}

/* 任务 */
.task-card {
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #552583;
}

.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-map {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.task-days {
  font-size: 24rpx;
  color: #c0392b;
}

.task-progress {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 入口 */
.entry {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.entry-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.entry-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entry-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.entry-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #bbb;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 空状态 */
.empty-box {
  padding: 50rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  background: #fff;
  border-radius: 16rpx;
}

.coming-soon {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c4bfd0;
  line-height: 1.7;
}

.entry + .entry {
  margin-top: 16rpx;
}

.task-actions {
  display: flex;
  margin-top: 18rpx;
}

.task-actions .task-btn + .task-btn {
  margin-left: 16rpx;
}

.task-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #552583, #3d1e63);
  border-radius: 12rpx;
}

.task-btn.ghost {
  color: #552583;
  background: #fff;
  border: 2rpx solid rgba(85, 37, 131, 0.2);
}

.entry-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #e74c3c;
  border-radius: 18rpx;
}
