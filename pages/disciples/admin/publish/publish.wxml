<!--pages/disciples/admin/publish/publish.wxml-->
<view class="page">
  <view class="loading-box" wx:if="{{loading}}"><text>加载地图中...</text></view>

  <block wx:else>
    <view class="card">
      <view class="row">
        <text class="k">地图</text>
        <picker mode="selector" range="{{mapNames}}" value="{{mapIndex < 0 ? 0 : mapIndex}}" bindchange="onMapChange">
          <view class="picker-value">
            <text>{{selectedMap ? selectedMap.name : '请选择地图'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="row">
        <text class="k">开始</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="picker-value"><text>{{startDate}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>

      <view class="row">
        <text class="k">结束</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndChange">
          <view class="picker-value"><text>{{endDate}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">分线目标</text>
      <text class="section-sub">选图后自动带出，可微调</text>
    </view>

    <view class="card">
      <view class="row" wx:for="{{lineRows}}" wx:key="level">
        <text class="k">{{item.level}}</text>
        <input class="edit-input" placeholder="{{item.level === '娱乐' ? '可留空' : '1:27.99'}}" value="{{item.timeText}}" data-index="{{index}}" bindinput="onLineInput"/>
      </view>
      <view class="hint">
        <text>国服记录只用于「超线完成」判定；娱乐可留空</text>
      </view>
    </view>

    <view class="actions">
      <view class="btn confirm {{saving ? 'disabled' : ''}}" bindtap="submit">发布任务</view>
    </view>
  </block>
</view>
