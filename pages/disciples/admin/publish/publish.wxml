<!--pages/disciples/admin/publish/publish.wxml-->
<view class="page">
  <view class="loading-box" wx:if="{{loading}}"><text>加载地图中...</text></view>

  <block wx:else>
    <view class="card">
      <view class="row">
        <text class="k">地图</text>
        <picker mode="selector" range="{{mapNames}}" value="{{mapIndex < 0 ? 0 : mapIndex}}" bindchange="onMapChange">
          <view class="picker-value">
            <text>{{selectedMap ? selectedMap.name : '请选择地图'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="row">
        <text class="k">开始</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="picker-value"><text>{{startDate}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>

      <view class="row">
        <text class="k">结束</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndChange">
          <view class="picker-value"><text>{{endDate}}</text><text class="picker-arrow">▾</text></view>
        </picker>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">分线目标</text>
      <text class="section-sub">选图后自动带出，可微调</text>
    </view>

    <view class="card">
      <view class="row" wx:for="{{lineRows}}" wx:key="level">
        <text class="k">{{item.level}}</text>
        <input class="edit-input" placeholder="{{item.level === '娱乐' ? '可留空' : '1:27.99'}}" value="{{item.timeText}}" data-index="{{index}}" bindinput="onLineInput"/>
      </view>
      <view class="hint">
        <text>国服记录只用于「超线完成」判定；娱乐可留空</text>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">视频讲解（选填）</text>
      <text class="section-sub">粘贴网盘分享内容自动识别</text>
    </view>

    <view class="card">
      <view class="form-block">
        <text class="k block">粘贴分享内容</text>
        <textarea class="textarea" placeholder="从网盘复制整段分享内容粘贴进来，例如：我用夸克网盘给你分享了「…」…提取码：tdnG" value="{{shareText}}" bindinput="onShareTextInput"/>
      </view>

      <view class="parsed" wx:if="{{videoUrl}}">
        <text class="parsed-line" wx:if="{{videoPlatform}}">✅ 已识别：{{videoPlatform}}</text>
        <text class="parsed-line">🔗 {{videoUrl}}</text>
        <text class="parsed-line" wx:if="{{videoCode}}">🔑 提取码：{{videoCode}}</text>
        <text class="parsed-line" wx:if="{{videoNote}}">🏷️ {{videoNote}}</text>
      </view>

      <view class="row">
        <text class="k">链接</text>
        <input class="edit-input" placeholder="自动识别，可手改" value="{{videoUrl}}" data-field="videoUrl" bindinput="onVideoInput"/>
      </view>

      <view class="row">
        <text class="k">提取码</text>
        <input class="edit-input" placeholder="选填，可手改" value="{{videoCode}}" data-field="videoCode" bindinput="onVideoInput"/>
      </view>
    </view>

    <view class="actions">
      <view class="btn confirm {{saving ? 'disabled' : ''}}" bindtap="submit">发布任务</view>
    </view>
  </block>
</view>
