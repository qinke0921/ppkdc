/* pages/disciples/admin/publish/publish.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.card {
  padding: 6rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.row:last-child {
  border-bottom: none;
}

.k {
  flex-shrink: 0;
  width: 170rpx;
  font-size: 26rpx;
  color: #888;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #552583;
  font-weight: 600;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 10rpx;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #999;
}

.edit-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  text-align: right;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 10rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 6rpx 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-sub {
  font-size: 22rpx;
  color: #bbb;
}

.hint {
  padding: 18rpx 0;
  font-size: 22rpx;
  color: #c4bfd0;
  text-align: center;
}

.actions {
  display: flex;
  margin-top: 44rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
}

.btn.confirm {
  background: linear-gradient(135deg, #552583, #3d1e63);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(85, 37, 131, 0.25);
}

.btn.disabled {
  opacity: 0.6;
}

/* 视频讲解 */
.form-block {
  padding: 22rpx 0 6rpx;
}

.k.block {
  display: block;
  width: auto;
  margin-bottom: 12rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  padding: 18rpx 22rpx;
  font-size: 25rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 10rpx;
}

.parsed {
  margin: 10rpx 0 6rpx;
  padding: 18rpx 22rpx;
  background: rgba(85, 37, 131, 0.05);
  border-radius: 10rpx;
}

.parsed-line {
  display: block;
  font-size: 23rpx;
  color: #552583;
  line-height: 1.7;
  word-break: break-all;
}
