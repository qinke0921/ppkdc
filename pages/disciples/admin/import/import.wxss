/* pages/disciples/admin/import/import.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.intro .title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.intro .desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.7;
}

.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat .num {
  font-size: 44rpx;
  font-weight: bold;
  color: #552583;
}

.stat .label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.hint {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}

.actions {
  display: flex;
  margin-bottom: 20rpx;
}

.actions .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 14rpx;
}

.btn.ghost {
  color: #552583;
  background: #fff;
  border: 2rpx solid rgba(85, 37, 131, 0.25);
}

.btn.confirm {
  color: #fff;
  background: linear-gradient(135deg, #552583, #3d1e63);
}

.btn.disabled {
  opacity: 0.6;
}

.progress {
  padding: 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #552583;
  background: rgba(85, 37, 131, 0.06);
  border-radius: 12rpx;
}

.unmatched-title {
  display: block;
  font-size: 25rpx;
  color: #c0392b;
  margin-bottom: 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 21rpx;
  color: #c4bfd0;
  line-height: 1.7;
}
