<!--pages/disciples/admin/reports/reports.wxml-->
<view class="page">
  <view class="loading-box" wx:if="{{loading}}"><text>加载中...</text></view>

  <block wx:else>
    <view class="head">
      <text class="head-title">待处理 {{total}} 条</text>
      <text class="head-hint">涉及 {{taskCount}} 个任务</text>
    </view>

    <view class="card" wx:for="{{list}}" wx:key="reportId">
      <view class="top">
        <text class="name">{{item.gameName}}</text>
        <text class="date">{{item.dateText}}</text>
      </view>
      <text class="map">任务：{{item.mapName}}</text>
      <text class="note" wx:if="{{item.note}}">反馈：{{item.note}}</text>
      <text class="url">链接：{{item.videoUrl || '—'}}</text>

      <view class="actions">
        <view class="btn ghost" catchtap="goTask" data-id="{{item.taskId}}">去修改视频</view>
        <view class="btn done" catchtap="resolve" data-id="{{item.reportId}}">已处理</view>
      </view>
    </view>

    <view class="empty-box" wx:if="{{list.length === 0}}">
      <text>暂无待处理的反馈</text>
    </view>

    <view class="tip">
      <text>在任务详情里更新视频后，该任务的反馈会自动标记为已处理</text>
    </view>
  </block>
</view>
