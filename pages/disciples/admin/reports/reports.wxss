/* pages/disciples/admin/reports/reports.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.loading-box {
  padding-top: 160rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.head-hint {
  font-size: 22rpx;
  color: #999;
}

.card {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #e74c3c;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.name {
  font-size: 29rpx;
  font-weight: 600;
  color: #333;
}

.date {
  font-size: 22rpx;
  color: #bbb;
}

.map {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.note {
  display: block;
  font-size: 23rpx;
  color: #c0392b;
  margin-bottom: 6rpx;
}

.url {
  display: block;
  font-size: 21rpx;
  color: #aaa;
  word-break: break-all;
}

.actions {
  display: flex;
  margin-top: 18rpx;
}

.actions .btn + .btn {
  margin-left: 16rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn.ghost {
  color: #552583;
  background: #fff;
  border: 2rpx solid rgba(85, 37, 131, 0.2);
}

.btn.done {
  color: #fff;
  background: linear-gradient(135deg, #552583, #3d1e63);
}

.empty-box {
  padding: 100rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: #c4bfd0;
  line-height: 1.7;
}
