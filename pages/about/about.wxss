/* pages/about/about.wxss */
/* 湖人紫金主题：#552583 紫色  #FDB927 金色 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
}

.content {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(85, 37, 131, 0.1);
  border-top: 6rpx solid #FDB927;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #552583;
  margin-bottom: 40rpx;
}

.desc {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.highlight {
  color: #552583;
  font-weight: bold;
}

.version {
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #999;
}